# OpenRouter API key (required for generation)
# Obtain your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE

# Model selection for OpenRouter (defaults to meta-llama/llama-3.3-70b-instruct if left blank)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# OpenRouter API Base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
